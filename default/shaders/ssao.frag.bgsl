$input v_texcoord0

#include <bgfx_shader.sh>

// @EngineSampler name="s_depth" stage="0" src="Renderer.sceneDepth"
SAMPLER2D(s_depth, 0);

// @EngineSampler name="s_normal" stage="1" src="Renderer.sceneNormal"
SAMPLER2D(s_normal, 1);

// @EngineUniform freq="frame" src="Renderer.SSAO.Params"
uniform vec4 u_ssaoParams;
// x = radius
// y = bias
// z = intensity
// w = unused

// @EngineUniform freq="frame" src="Renderer.SSAO.Resolution"
uniform vec4 u_ssaoResolution;
// x = full width
// y = full height
// z = inverse full width
// w = inverse full height

// @EngineUniform freq="frame" src="Engine.FrameCount"
uniform vec4 u_frameCount; // x = frame count, yzw = unused

#define PI 3.14159265

#define SSAO_DIRECTIONS 4
#define SSAO_STEPS 3

vec3 reconstructPosition(vec2 uv, float depth) {
    vec2 clipXY = uv * 2.0 - 1.0;
    clipXY.y = -clipXY.y;

    vec4 clip = vec4(clipXY, depth, 1.0);
    vec4 view = mul(u_invProj, clip);
    return view.xyz / view.w;
}

float reconstructViewZ(float depth) {
    vec4 view = mul(u_invProj, vec4(0.0, 0.0, depth, 1.0));
    return view.z / view.w;
}

float interleavedGradientNoise(vec2 pixelCoords) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(magic.z * fract(dot(pixelCoords, magic.xy)));
}

void main() {
    vec2 uv = v_texcoord0.xy;
    float depth = texture2D(s_depth, uv).r;

    if (depth >= 0.9999) {
        gl_FragColor = vec4_splat(1.0);
        return;
    }

    vec3 position = reconstructPosition(uv, depth);

    // View-space normal
    vec3 worldNormal = texture2D(s_normal, uv).xyz * 2.0 - 1.0;
    vec3 normal = normalize(mul(u_view, vec4(worldNormal, 0.0)).xyz);

    // Radius / projection
    float radius = u_ssaoParams.x;
    float radiusSq = radius * radius;
    float viewDepth = max(abs(position.z), 0.001);
    float screenRadius = radius * u_proj[1][1] / viewDepth * 0.5;

    // Allow the radius to actually grow when the camera gets close.
    screenRadius = clamp(screenRadius, max(u_ssaoResolution.z, u_ssaoResolution.w) * 2.0, 1.0);

    // Blue-noise rotation
    vec2 aoResolution = u_ssaoResolution.xy * 0.5;
    vec2 aoPixel = floor(uv * aoResolution);
    vec2 noiseUV = (mod(aoPixel, 64.0) + 0.5) / 64.0;

    float staticNoise = interleavedGradientNoise(aoPixel);
    float temporalOffset = mod(u_frameCount.x, 64.0) * 0.61803398875;
    float noise = fract(staticNoise + temporalOffset);

    float angle = noise * PI * 2.0;
    float c = cos(angle);
    float s = sin(angle);

    // AO
    float occlusion = 0.0;
    float totalSamples = float(SSAO_DIRECTIONS * SSAO_STEPS);
    float aspectRatio = u_ssaoResolution.x * u_ssaoResolution.w;

    for (int d = 0; d < SSAO_DIRECTIONS; ++d) {
        float baseAngle = float(d) * (2.0 * PI / float(SSAO_DIRECTIONS));
        float sampleAngle = baseAngle + angle;
        vec2 direction = vec2(cos(sampleAngle), sin(sampleAngle) * aspectRatio);

        for (int sampleIndex = 1; sampleIndex <= SSAO_STEPS; ++sampleIndex) {
            // Jitter the radius with noise to reduce banding.
            float t = (float(sampleIndex) - noise) / float(SSAO_STEPS);
            float stepDist = mix(0.1, 1.0, t);
            vec2 sampleUV = uv + direction * screenRadius * stepDist;

            if (sampleUV.x <= 0.0 || sampleUV.x >= 1.0 || sampleUV.y <= 0.0 || sampleUV.y >= 1.0) {
                continue;
            }

            float sampleDepth = texture2D(s_depth, sampleUV).r;
            if (sampleDepth >= 0.9999) {
                continue;
            }

            vec3 samplePos = reconstructPosition(sampleUV, sampleDepth);
            vec3 sampleVector = samplePos - position;
            float distSq = dot(sampleVector, sampleVector);

            if (distSq >= radiusSq) {
                continue;
            }

            float dist = sqrt(distSq);
            vec3 sampleDirection = sampleVector / max(dist, 0.0001);
            float hemisphere = dot(normal, sampleDirection);

            if (hemisphere <= u_ssaoParams.y) {
                continue;
            }

            float rangeWeight = 1.0 - (dist / radius);
            rangeWeight = max(0.0, rangeWeight);
            rangeWeight *= rangeWeight;

            occlusion += hemisphere * rangeWeight;
        }
    }

    occlusion /= totalSamples;

    // Scale intensity
    occlusion *= u_ssaoParams.z;
    occlusion = clamp(occlusion, 0.0, 1.0);

    float visibility = 1.0 - occlusion;
    visibility = pow(visibility, u_ssaoParams.z);

    gl_FragColor = vec4_splat(visibility);
}
