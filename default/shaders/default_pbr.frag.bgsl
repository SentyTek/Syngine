$input v_worldPos v_normal v_viewDepth v_vertexColor v_uvScaled v_uvMacro v_uvDetail v_tangent

#include <bgfx_shader.sh>

#include "shadow.bgsl"
#include "common.bgsl"

//texture slots
// @Sampler name="s_albedo" stage="0"
SAMPLER2D(s_albedo, 0);
// @Sampler name="s_normalMap" stage="1"
SAMPLER2D(s_normalMap, 1);

//lighting + material params
// @EngineUniform freq="draw" src="Renderer.SunDirection"
uniform vec4 u_lightDir; //worldspace sun dir w = receive shadows (1.0 yes / 0.0 no)
// @EngineUniform freq="draw" src="Renderer.SkyColorZenith"
uniform vec4 u_skyColor; //hemisphere ambient sky color
// @EngineUniform freq="draw" src="Renderer.SunColor"
uniform vec4 u_sunColor; //sunlight color w = intensity
// @EngineUniform freq="draw" src="Renderer.HorizonColor"
uniform vec4 u_horizonColor; // same as u_scatterColor in sky shader (horizon scatter color)

// @MaterialParameter
uniform vec4 u_baseColor;       // Base color fallback when no texture is present
// @MaterialParameter
uniform vec4 u_materialParams1; // mixFactor, ambient, uvOverride, useVertexColor
// @MaterialParameter
uniform vec4 u_materialParams2; // x = use albedo texture (1.0) vs base color (0.0) y = use normal map (0.0 yes / 1.0 no)

void main() {
    vec3 lightDirToSun = normalize(u_lightDir.xyz);
    float sunElevation = lightDirToSun.y;

    vec3 vN = normalize(v_normal);
    vec3 T = normalize(v_tangent.xyz);
    vec3 B = cross(vN, T) * v_tangent.w;

    vec4 baseColor = mix(u_baseColor, v_vertexColor, u_materialParams1.w);
    vec3 albedoRgb = baseColor.rgb;
    if (u_materialParams2.x > 0.5) {
        vec4 albedo = texture2D(s_albedo, v_uvDetail * v_uvScaled.x);
        albedoRgb = albedo.rgb * baseColor.rgb;
    }

    vec3 Nmicro = vN;
    if (u_materialParams2.y < 0.5) {
        vec3 nmap = texture2D(s_normalMap, v_uvDetail * v_uvScaled.y).xyz * 2.0 - 1.0;
        Nmicro = normalize(T*nmap.x + B*nmap.y + vN*nmap.z);
    }
    vec3 N = normalize(mix(vN, Nmicro, u_materialParams1.x));

    float hemiMix = N.y * 0.5 + 0.5;
    vec3 skyColor = u_skyColor.xyz;

    float NdotL = max(dot(N, lightDirToSun), 0.0);
    float nightFactor = clamp(smoothstep(-0.05, 0.05, sunElevation), 0.2, 1.0);
    vec3 ambient = mix(albedoRgb, skyColor, hemiMix) * u_materialParams1.y;

    float microShadow = clamp(dot(Nmicro, lightDirToSun) * 2.0 + 0.3, 0.0, 1.0);
    float shadow = 1.0;
    if (u_lightDir.w > 0.5) {
        shadow = getShadowFactor(v_worldPos, vN, u_lightDir, v_viewDepth);
        shadow = mix(1.0, shadow, smoothstep(0.1, 0.3, sunElevation));
    }

    float sunIntensity = smoothstep(-0.1, 0.1, sunElevation);
    vec3 directLight = u_sunColor.xyz * u_sunColor.w * sunIntensity * NdotL * shadow * microShadow;
    vec3 bounce = u_sunColor.xyz * u_sunColor.w * sunIntensity * 0.2 * clamp(dot(N, -lightDirToSun), 0.2, 1.0);

    vec3 viewDir = normalize(u_viewPos.xyz - v_worldPos);
    vec3 F0 = vec3_splat(0.02);
    vec3 halfVec = normalize(lightDirToSun + viewDir);
    float NdotH = max(dot(N, halfVec), 0.0);
    float specPower = 32.0;
    float specStrength = pow(NdotH, specPower) * microShadow * shadow * 0.15;
    vec3 fresnel = fresnelSchlick(max(dot(N, viewDir), 0.0), F0);

    float fogDist = length(v_worldPos);
    float fogFactor = 1.0 - exp(-fogDist * 0.0005);

    float terrainLightExposure = 0.7;
    vec3 lit = (ambient + directLight + bounce) * nightFactor;
    vec3 spec = (directLight * specStrength * fresnel) * nightFactor;
    lit *= terrainLightExposure;
    spec *= terrainLightExposure;

    vec3 finalColor = albedoRgb * lit + spec;
    finalColor = mix(finalColor, u_horizonColor.xyz, fogFactor);

    gl_FragData[0] = vec4(finalColor, 1.0);
    gl_FragData[1] = vec4(N * 0.5 + 0.5, 1.0);
}
