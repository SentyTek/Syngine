$input v_texcoord0

#include <bgfx_shader.sh>

// @EngineSampler name="s_ssao" stage="0" src="Renderer.ssaoTex"
SAMPLER2D(s_ssao, 0);
// @EngineSampler name="s_depth" stage="1" src="Renderer.sceneDepth"
SAMPLER2D(s_depth, 1);
// @EngineSampler name="s_normal" stage="2" src="Renderer.sceneNormal"
SAMPLER2D(s_normal, 2);

// @EngineUniform freq="frame" src="Renderer.SSAOBlur.Params"
uniform vec4 u_floats;
// x = blur radius
// y = vertical (1.0) / horizontal (0.0)
// z = width
// w = height

float linearizeDepth(float depth)
{
    vec4 viewPos = mul(u_invProj, vec4(0.0, 0.0, depth, 1.0));

    return abs(viewPos.z / viewPos.w);
}

void main() {
    vec2 uv = v_texcoord0.xy;

    vec2 texelSize = vec2(1.0 / u_floats.z, 1.0 / u_floats.w);
    vec2 blurDir = (u_floats.y > 0.5) ? vec2(0.0, 1.0) : vec2(1.0, 0.0);
    vec2 stepSize = blurDir * texelSize;

    float centerDepth = texture2D(s_depth, uv).r;
    centerDepth = linearizeDepth(centerDepth);

    vec3 centerNormal = texture2D(s_normal, uv).xyz * 2.0 - 1.0;

    float totalAO = 0.0;
    float totalWeight = 0.0;

    const int BLUR_RADIUS = 4;

    UNROLL
    for (int i = -BLUR_RADIUS; i <= BLUR_RADIUS; ++i) {
        vec2 sampleUV = uv + stepSize * float(i);
        vec2 sampleSSAOUV = vec2(sampleUV.x, 1.0 - sampleUV.y);

        float ao = texture2D(s_ssao, sampleSSAOUV).r;
        float sampleDepth = texture2D(s_depth, sampleUV).r;
        sampleDepth = linearizeDepth(sampleDepth);
        vec3 sampleNormal = texture2D(s_normal, sampleUV).xyz * 2.0 - 1.0;

        float x = float(i);
        float sigma = 3.0;

        float spatialWeight = exp(-(x * x) / (2.0 * sigma * sigma));

        // Relaxed normal check. Allows curved surfaces to blur, stops at hard corners.
        float normalDot = max(dot(centerNormal, sampleNormal), 0.0);
        float normalWeight = smoothstep(0.3, 0.8, normalDot);

        // Relaxed depth check. 100.0 instead of 1000.0, using an inverse curve.
        float depthSigma = 0.15;
        float depthDiff = abs(centerDepth - sampleDepth);
        float depthWeight = exp(-(depthDiff * depthDiff) / (2.0 * depthSigma * depthSigma));

        float weight = spatialWeight * normalWeight * depthWeight;

        totalAO += ao * weight;
        totalWeight += weight;
    }

    gl_FragColor = vec4_splat(totalAO / max(totalWeight, 0.0001));
}
